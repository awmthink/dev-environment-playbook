# 代理地址示例（脱敏）
# 真实文件放 ~/.config/shell/proxy.env（仓库外、不提交）
# 默认关闭：本文件只定义变量与开关函数，不自动导出；需要时在 shell 里 proxy_on
#
# 出口声明（客户端与分流规则见 tools/mihomo.md，用户只配下面两个出口变量）：
#   MIHOMO_SUB_URL  —— 订阅连接（含 token）：出口之一，由 configs/mihomo/render.py 渲染进 config.yaml
#   MIHOMO_NODE_URL —— 自定义扩展节点（http/socks5 代理 URL 形式）：出口之二，兼作应急手动 curl -x
#                      留空则渲染出不带自定义节点的配置；ss/vmess 等复杂节点类型直接改 config.yaml

MIHOMO_URL="http://127.0.0.1:7890"          # mihomo mixed 端口，HTTP 与 SOCKS5 同端口；proxy_on 的目标
MIHOMO_SUB_URL="https://__SUB_HOST__/__SUB_PATH__?clash=3"
MIHOMO_NODE_URL="http://__NODE_USER__:__NODE_PASSWORD__@__NODE_HOST__:__NODE_PORT__"
NO_PROXY_LIST="localhost,127.0.0.1,::1,.local"

# 便捷开关函数（source 本文件后可用；只改当前 shell 环境变量，幂等）
proxy_on()  { export http_proxy="$MIHOMO_URL" https_proxy="$MIHOMO_URL" \
                      HTTP_PROXY="$MIHOMO_URL" HTTPS_PROXY="$MIHOMO_URL" \
                      ALL_PROXY="$MIHOMO_URL" all_proxy="$MIHOMO_URL" \
                      NO_PROXY="$NO_PROXY_LIST" no_proxy="$NO_PROXY_LIST"; echo "proxy on → mihomo（国内直连/境外走节点）"; }
proxy_off() { unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy NO_PROXY no_proxy; echo "proxy off"; }
