# 代理地址示例（脱敏）
# 真实文件放 ~/.config/shell/proxy.env（仓库外、不提交）
# 默认关闭：本文件只定义变量与开关函数，不自动导出；需要时在 shell 里 proxy_on

PROXY_URL="http://127.0.0.1:7890"
PROXY_SOCKS_URL="socks5://127.0.0.1:7890"
NO_PROXY_LIST="localhost,127.0.0.1,::1,.local"

# 便捷开关函数（source 本文件后可用；只改当前 shell 环境变量，幂等）
proxy_on()  { export HTTP_PROXY="$PROXY_URL" HTTPS_PROXY="$PROXY_URL" \
                     ALL_PROXY="$PROXY_SOCKS_URL" NO_PROXY="$NO_PROXY_LIST" \
                     http_proxy="$PROXY_URL" https_proxy="$PROXY_URL" \
                     all_proxy="$PROXY_SOCKS_URL" no_proxy="$NO_PROXY_LIST"; echo "proxy on"; }
proxy_off() { unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY \
                     http_proxy https_proxy all_proxy no_proxy; echo "proxy off"; }
