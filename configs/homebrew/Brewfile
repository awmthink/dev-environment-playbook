# configs/homebrew/Brewfile — 参考装机清单（只读实物）
#
# 角色：brew 是 **macOS 包管理器**。
#   - cask：GUI app + 字体（brew 不可替代的部分）
#   - formula：不需要多版本的 CLI 工具（按 core principle 逐工具评估，macOS 上 brew 最 canonical）。
#     runtime / build / LSP 仍归 mise（见 configs/mise/config.toml）。
#   编译器：mac=Xcode CLT，不入 brew（曾用 brew llvm，现移除）。
#
#   复现：  brew bundle install --file configs/homebrew/Brewfile
#   对账：  brew bundle check   --file configs/homebrew/Brewfile

# ===== CLI 工具（不需要多版本；macOS 上 brew 最 canonical）=====
brew "ripgrep"               # 全文搜索
brew "jq"                    # JSON 处理
brew "fzf"                   # 模糊查找（装后跑 $(brew --prefix)/opt/fzf/install 配 keybinds）
brew "zellij"                 # 多路复用（替代 tmux，见 tools/zellij.md）
brew "starship"              # 提示符（见 tools/starship.md）

# ===== GUI 应用（cask）=====
cask "ghostty"                    # tools/ghostty.md（macOS 主力终端）
cask "zed"                        # tools/zed.md（GUI 主力 editor）

# ===== 字体 =====
cask "font-maple-mono-nf-cn"           # profile.md 主力字体（中英混排 / Nerd Font 图标）
cask "font-jetbrains-mono-nerd-font"   # profile.md 备选字体
