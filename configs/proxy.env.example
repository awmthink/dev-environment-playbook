# 代理地址示例（脱敏）
# 真实文件放 ~/.config/dev-env/proxy.env（已被 .gitignore 忽略，切勿提交真实地址/凭据）

export HTTP_PROXY="http://127.0.0.1:7890"
export HTTPS_PROXY="http://127.0.0.1:7890"
export ALL_PROXY="socks5://127.0.0.1:7890"
export NO_PROXY="localhost,127.0.0.1,::1,.local"

# 小写版本（部分工具只认小写）
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"
export all_proxy="$ALL_PROXY"
export no_proxy="$NO_PROXY"

# 便捷开关函数（source 本文件后可用）
proxy_on()  { export HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY \
                     http_proxy https_proxy all_proxy no_proxy; echo "proxy on"; }
proxy_off() { unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY \
                     http_proxy https_proxy all_proxy no_proxy; echo "proxy off"; }
